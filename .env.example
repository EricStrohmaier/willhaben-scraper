# Optional: Set an API key to require authentication
# API_KEY=your-secret-key

# Port (default: 3100)
# PORT=3100

# Max concurrent scraping jobs (default: 3)
# MAX_CONCURRENT=3

# Optional: Bright Data Browser API endpoint for hard-to-scrape sites.
# SCRAPING_BROWSER_WS=wss://brd-customer-XXXX-zone-scraping_browser1:PASSWORD@brd.superproxy.io:9222

# ─── Database ─────────────────────────────────────────────────────────────

# Remote Turso database (optional — defaults to local SQLite at data/scraping.db)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Or use a custom local path:
# LOCAL_DB_PATH=./data/scraping.db

# ─── OpenAI (for listing matching) ───────────────────────────────────────

# OPENAI_API_KEY=sk-...

# ─── Notifications ───────────────────────────────────────────────────────

# Webhook URL for match notifications (receives JSON POST)
# NOTIFICATION_WEBHOOK=https://hooks.slack.com/services/...
